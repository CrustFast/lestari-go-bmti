---
interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Lestari | Layanan Ekosistem Terpadu Asri',
	description = 'Lestari menyediakan jasa pembuatan taman, perawatan lanskap, dan desain ruang hijau yang memadukan keindahan, fungsi, dan keberlanjutan.'
} = Astro.props;

import Preloader from '../components/Preloader.astro';
---

<!doctype html>
<html lang="id">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/png" href="/favicon-square.png" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>

		<!-- Google Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Montserrat:wght@500;600;700;800;900&family=Playfair+Display:ital,wght@0,400;0,700;1,400;1,700&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<Preloader />
		<slot />
	</body>
</html>

<style is:global>
	*,
	*::before,
	*::after {
		margin: 0;
		padding: 0;
		box-sizing: border-box;
	}

	:root {
		/* Primary greens */
		--green-900: #0a2e14;
		--green-800: #14532d;
		--green-700: #166534;
		--green-600: #1EA02F;
		--green-500: #24ba37;
		--green-400: #4ade80;
		--green-300: #86efac;
		--green-100: #dcfce7;
		--green-50: #f0fdf4;

		/* Accent */
		--yellow-500: #eab308;
		--yellow-400: #facc15;

		/* Neutrals */
		--white: #ffffff;
		--gray-50: #f9fafb;
		--gray-100: #f3f4f6;
		--gray-200: #e5e7eb;
		--gray-300: #d1d5db;
		--gray-500: #6b7280;
		--gray-600: #4b5563;
		--gray-700: #374151;
		--gray-800: #1f2937;
		--gray-900: #111827;

		/* Typography */
		--font-sans: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
		--font-serif: 'Playfair Display', Georgia, 'Times New Roman', serif;
		--font-heading: 'Montserrat', sans-serif;

		/* UI Components */
		--btn-primary-bg: #1EA02F; /* --green-600 */
		--btn-primary-hover: #24ba37; /* --green-500 */

		/* Spacing */
		--container-max: 1280px;
		--container-padding: 1.5rem;

		/* Transitions */
		--transition-fast: 150ms ease;
		--transition-base: 250ms ease;
		--transition-slow: 400ms ease;
	}

	html {
		/* Removed scroll-behavior: smooth as Lenis handles it better */
	}

	html,
	body {
		margin: 0;
		padding: 0;
		width: 100%;
		min-height: 100vh;
		font-family: var(--font-sans);
		color: var(--gray-900);
		background-color: var(--white);
		-webkit-font-smoothing: antialiased;
		-moz-osx-font-smoothing: grayscale;
	}

	/* Lenis Global Styles */
	html.lenis, html.lenis body {
		height: auto;
	}

	.lenis.lenis-smooth {
		scroll-behavior: auto !important;
	}

	.lenis.lenis-smooth [data-lenis-prevent] {
		overscroll-behavior: contain;
	}

	.lenis.lenis-stopped {
		overflow: hidden;
	}

	.lenis.lenis-smooth iframe {
		pointer-events: none;
	}

	img {
		max-width: 100%;
		height: auto;
		display: block;
	}

	a {
		text-decoration: none;
		color: inherit;
	}

	ul,
	ol {
		list-style: none;
	}

	button {
		cursor: pointer;
		border: none;
		background: none;
		font-family: inherit;
	}

	/* Buttons */
	.btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		padding: 0.65rem 1.5rem;
		font-size: 0.95rem;
		font-weight: 600;
		border-radius: 50px;
		transition: background var(--transition-fast), transform var(--transition-fast), box-shadow var(--transition-fast);
		white-space: nowrap;
	}

	.btn-icon {
		flex-shrink: 0;
	}

	.btn-primary {
		background: var(--btn-primary-bg);
		color: var(--white);
	}

	.btn-primary:not(.btn-animated):hover {
		background: var(--btn-primary-hover);
		transform: translateY(-2px);
		box-shadow: 0 4px 12px rgba(30, 160, 47, 0.4);
	}

	/* Animated Button Styling */
	.btn-animated {
		width: 195px;
		padding: 0.65rem 1rem; 
		gap: 0.75rem;
		justify-content: center;
		transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
		overflow: hidden;
	}

	.btn-text {
		transition: max-width 0.4s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.4s cubic-bezier(0.4, 0, 0.2, 1), transform 0.4s cubic-bezier(0.4, 0, 0.2, 1), margin 0.4s cubic-bezier(0.4, 0, 0.2, 1);
		max-width: 200px;
		opacity: 1;
		transform: translateX(0);
		white-space: nowrap;
	}

	.icon-bg {
		transition: fill 0.4s ease;
	}

	.icon-arrow {
		transition: stroke 0.4s ease, transform 0.4s ease;
		transform-origin: center;
	}

	.btn-primary.btn-animated:hover {
		background: var(--white);
		transform: translateY(-2px);
		box-shadow: 0 4px 15px rgba(30, 160, 47, 0.1), inset 0 0 0 1.5px var(--btn-primary-bg);
	}

	.btn-animated:hover .btn-text {
		max-width: 0;
		opacity: 0;
		transform: translateX(-15px);
		margin: 0;
	}

	.btn-animated:hover .icon-bg {
		fill: var(--btn-primary-bg);
	}

	.btn-animated:hover .icon-arrow {
		stroke: var(--white);
		transform: rotate(45deg);
	}

	.btn-secondary {
		background: rgba(255, 255, 255, 0.1);
		color: var(--white);
		border: 1px solid rgba(255, 255, 255, 0.25);
		backdrop-filter: blur(4px);
	}

	.btn-secondary:hover {
		background: rgba(255, 255, 255, 0.2);
		border-color: rgba(255, 255, 255, 0.4);
		transform: translateY(-2px);
	}

	/* Animations */
	[data-animate] {
		opacity: 0;
		transform: translateY(30px);
		transition: opacity 0.7s ease, transform 0.7s ease;
	}

	[data-animate="fade-left"] {
		transform: translateX(40px);
	}

	[data-animate="fade-right"] {
		transform: translateX(-40px);
	}

	[data-animate="fade-up"] {
		transform: translateY(40px);
	}

	[data-animate].animate-in {
		opacity: 1;
		transform: translate(0, 0);
	}
</style>

<script>
	import Lenis from 'lenis';

	document.addEventListener('DOMContentLoaded', () => {
		// Initialize Lenis for smooth scrolling
		const lenis = new Lenis({
			autoRaf: true,
		});

		// Handle smooth scrolling for anchor links using Lenis
		document.querySelectorAll('a[href^="#"]').forEach(anchor => {
			anchor.addEventListener('click', function (e) {
				e.preventDefault();
				const target = e.currentTarget as HTMLAnchorElement;
				const targetId = target.getAttribute('href');
				if (targetId && targetId !== '#') {
					const targetElement = document.querySelector<HTMLElement>(targetId);
					if (targetElement) {
						lenis.scrollTo(targetElement);
					}
				}
			});
		});

		const animateElements = document.querySelectorAll('[data-animate]');

		const observer = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						const delay = parseInt(entry.target.getAttribute('data-delay') || '0');
						setTimeout(() => {
							entry.target.classList.add('animate-in');
						}, delay);
						observer.unobserve(entry.target);
					}
				});
			},
			{ threshold: 0.1 }
		);

		animateElements.forEach((el) => observer.observe(el));
	});
</script>
