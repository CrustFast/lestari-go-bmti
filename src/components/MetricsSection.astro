---
import MetricCard from './MetricCard.astro';

const mainMetrics = [
	{
		icon: 'zap',
		badge: 'Energi Terbarukan',
		value: '≥20%',
		title: 'Kemandirian Energi',
		description: 'Pemenuhan kebutuhan energi operasional kampus yang bersumber dari infrastruktur PLTS, PLTB, dan teknologi pirolisis.'
	},
	{
		icon: 'leaf-down',
		badge: 'Quick Wins 2026',
		value: '≥5%',
		title: 'Efisiensi Biaya Utilitas',
		description: 'Penurunan tajam pada tagihan konsumsi listrik (sebelumnya Rp71,1 Juta/bulan) dan air melalui Smart Energy Management System.'
	},
	{
		icon: 'recycle',
		badge: 'Ekonomi Sirkular',
		value: '≥10%',
		title: 'Reduksi Sampah ke TPA',
		description: 'Penurunan volume limbah operasional serta pengelolaan 100% sampah organik kampus secara mandiri melalui Green Point.'
	}
];

const secondaryMetrics = [
	{
		icon: 'water',
		value: '20 Titik Resapan Air',
		description: 'Pembangunan biopori dan sumur resapan guna memulihkan fungsi hidrologi kawasan.'
	},
	{
		icon: 'map',
		value: '130.976 m² Lahan Terkelola',
		description: 'Optimalisasi seluruh ruang terbuka hijau dan bengkel sebagai Living Laboratory.'
	},
	{
		icon: 'wind',
		value: '23,8 kW Kapasitas Bersih',
		description: 'Total energi dari fasilitas PLTS (20,8 kW) dan PLTB (3 kW) BMTI yang telah terpasang.'
	}
];
---

<section id="metrik" class="metrics-section">
	<div class="metrics-container">
		<!-- Section Header -->
		<div class="metrics-header" data-animate="fade-up">
			<div class="header-left">
				<div class="section-label">
					<span class="pulse-dot"></span>
					TARGET & PENCAPAIAN PROGRAM
				</div>
				<h2 class="section-heading">Dampak Nyata Keberlanjutan</h2>
			</div>
			<div class="header-right">
				<div class="header-badge">Target Peta Jalan 2026–2030</div>
			</div>
		</div>

		<!-- Main Metrics Grid -->
		<div class="main-grid">
			{mainMetrics.map((metric, index) => (
				<div data-animate="fade-up" data-delay={index * 100}>
					<MetricCard 
						variant="large"
						icon={metric.icon}
						badge={metric.badge}
						value={metric.value}
						title={metric.title}
						description={metric.description}
					/>
				</div>
			))}
		</div>

		<!-- Secondary Metrics Grid -->
		<div class="secondary-grid">
			{secondaryMetrics.map((metric, index) => (
				<div data-animate="fade-up" data-delay={300 + (index * 100)}>
					<MetricCard 
						variant="small"
						icon={metric.icon}
						value={metric.value}
						description={metric.description}
					/>
				</div>
			))}
		</div>
	</div>
</section>

<style>
	.metrics-section {
		background-color: var(--green-900); /* Dark green background like the design */
		padding: 4.5rem 0;
		color: var(--white);
		position: relative;
		overflow: hidden;
	}

	/* Optional: Add a subtle background pattern or gradient to make it richer */
	.metrics-section::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background: radial-gradient(circle at top right, rgba(30, 160, 47, 0.15) 0%, transparent 60%);
		pointer-events: none;
	}

	.metrics-container {
		max-width: var(--container-max);
		margin: 0 auto;
		padding: 0 var(--container-padding);
		position: relative;
		z-index: 1;
	}

	/* Header */
	.metrics-header {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		margin-bottom: 2.5rem;
	}

	.header-left {
		flex: 1;
	}

	.section-label {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		color: var(--green-400);
		font-weight: 700;
		font-size: 0.8rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		margin-bottom: 0.75rem;
	}

	.pulse-dot {
		width: 10px;
		height: 10px;
		background-color: var(--green-400);
		border-radius: 50%;
		position: relative;
	}

	.pulse-dot::after {
		content: '';
		position: absolute;
		top: -4px;
		left: -4px;
		right: -4px;
		bottom: -4px;
		border-radius: 50%;
		background-color: var(--green-400);
		opacity: 0.4;
		animation: pulse 2s infinite;
	}

	@keyframes pulse {
		0% { transform: scale(1); opacity: 0.4; }
		70% { transform: scale(2); opacity: 0; }
		100% { transform: scale(1); opacity: 0; }
	}

	.section-heading {
		font-family: var(--font-heading);
		font-size: clamp(1.75rem, 3vw, 2.25rem);
		font-weight: 700;
		color: var(--white);
		line-height: 1.2;
		margin: 0;
	}

	.header-right {
		display: flex;
		align-items: flex-start;
	}

	.header-badge {
		background: rgba(255, 255, 255, 0.1);
		border: 1px solid rgba(255, 255, 255, 0.2);
		padding: 0.6rem 1.25rem;
		border-radius: 50px;
		font-size: 0.9rem;
		font-weight: 600;
		color: var(--white);
		backdrop-filter: blur(4px);
	}

	/* Grids */
	.main-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1.25rem;
		margin-bottom: 1.25rem;
	}

	.secondary-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1.25rem;
	}

	/* Responsive */
	@media (min-width: 768px) {
		.metrics-header {
			flex-direction: row;
			justify-content: space-between;
			align-items: flex-end;
		}

		.header-right {
			align-items: flex-end;
			padding-bottom: 0.5rem;
		}

		.main-grid {
			grid-template-columns: repeat(2, 1fr);
		}

		.secondary-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (min-width: 1024px) {
		.main-grid {
			grid-template-columns: repeat(3, 1fr);
		}

		.secondary-grid {
			grid-template-columns: repeat(3, 1fr);
		}
	}
</style>
