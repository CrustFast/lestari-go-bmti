</style>

<script define:vars={{ sdgsData }}>
    document.addEventListener('DOMContentLoaded', () => {
        const buttons = document.querySelectorAll('.detail-btn');
        const overlay = document.getElementById('sdg-drawer-overlay');
        const drawer = document.getElementById('sdg-drawer');
        const closeBtn = document.querySelector('.drawer-close');

        const drawerBgNumber = document.getElementById('drawer-bg-number');
        const drawerBadge = document.getElementById('drawer-badge');
        const drawerTitle = document.getElementById('drawer-title');
        const drawerActivities = document.getElementById('drawer-activities');

        const openDrawer = (goalId) => {
            const data = sdgsData.find(s => s.goal === goalId);
            if (!data) return;

            // Set content
            drawerBgNumber.textContent = data.goal;
            drawerBadge.textContent = data.panelHeader;
            drawerTitle.textContent = data.panelTitle;
            
            // Clear and populate activities
            drawerActivities.innerHTML = '';
            data.activities.forEach(act => {
                const li = document.createElement('li');
                li.textContent = act;
                drawerActivities.appendChild(li);
            });

            // Set dynamic background color
            drawer.style.setProperty('--drawer-bg', data.color);

            // Open
            overlay.classList.add('active');
            drawer.classList.add('active');
            document.body.style.overflow = 'hidden'; // prevent background scrolling
        };

        const closeDrawer = () => {
            overlay.classList.remove('active');
            drawer.classList.remove('active');
            document.body.style.overflow = '';
        };

        buttons.forEach(btn => {
            btn.addEventListener('click', (e) => {
                e.preventDefault();
                const goalId = btn.getAttribute('data-goal');
                openDrawer(goalId);
            });
        });

        closeBtn.addEventListener('click', closeDrawer);
        overlay.addEventListener('click', closeDrawer);

        // Lightbox Logic
        const lightbox = document.getElementById('gallery-lightbox');
        const lbImg = document.getElementById('lightbox-img');
        const lbCat = document.getElementById('lightbox-category');
        const lbTitle = document.getElementById('lightbox-title');
        const lbDesc = document.getElementById('lightbox-desc');
        const lbDate = document.getElementById('lightbox-date');
        const lbLoc = document.getElementById('lightbox-location');
        const lbParties = document.getElementById('lightbox-parties');
        const lbCloseBtn = document.getElementById('lightbox-close-btn');
        const lbOverlay = document.getElementById('lightbox-close');
        const lbCard = document.getElementById('lightbox-card');
        const lbToggle = document.getElementById('lightbox-toggle-card');
        const iconHide = document.getElementById('icon-hide');
        const iconShow = document.getElementById('icon-show');


        if (lbToggle && lbCard && iconHide && iconShow) {
            lbToggle.addEventListener('click', (e) => {
                e.stopPropagation();
                lbCard.classList.toggle('hidden');
                if (lbCard.classList.contains('hidden')) {
                    iconHide.style.display = 'none';
                    iconShow.style.display = 'block';
                } else {
                    iconHide.style.display = 'block';
                    iconShow.style.display = 'none';
                }
            });
        }

        const closeLightbox = () => {
            if (lightbox) lightbox.classList.remove('active');
            setTimeout(() => {
                if (lbImg) lbImg.setAttribute('src', '');
                if (lbCard) lbCard.classList.remove('hidden');
                if (iconHide) iconHide.style.display = 'block';
                if (iconShow) iconShow.style.display = 'none';
            }, 400);
        };

        if (lbCloseBtn) lbCloseBtn.addEventListener('click', closeLightbox);
        if (lbOverlay) lbOverlay.addEventListener('click', closeLightbox);
    });
</script>
