        display: inline-block;
        border: 1px solid #ffffff;
        padding: 0.5rem 1.5rem;
        border-radius: 4px;
        color: #ffffff;
        text-align: center;
        font-weight: 600;
        font-size: 0.95rem;
        text-decoration: none;
        background: transparent;
        transition: all 0.2s ease;
        cursor: pointer;
    }

    .drawer-action-btn:hover {
