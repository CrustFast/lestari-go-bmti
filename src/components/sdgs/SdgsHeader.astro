<style>
	.sdgs-header {
		min-height: 100vh;
		display: flex;
		align-items: center;
		padding-top: 4rem; /* Account for navbar */
		background-image: url('/img/kandep4.jpg');
		background-size: cover;
		background-position: center;
		background-attachment: fixed;
		position: relative;
		overflow: hidden;
	}
	
	.sdgs-header::before {
		content: '';
		position: absolute;
		inset: 0;
		background: rgba(10, 46, 20, 0.85); /* Dark green overlay */
		z-index: 1;
	}

	.header-container {
		width: 100%;
		max-width: var(--container-max);
		margin: 0 auto;
		padding: 0 var(--container-padding);
		position: relative;
		z-index: 2;
	}

	.header-content {
		max-width: 800px;
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
	}

	/* Breadcrumb */
	.breadcrumb {
		margin-bottom: 2rem;
		background: rgba(255, 255, 255, 0.1);
		padding: 0.5rem 1rem;
		border-radius: 50px;
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
		border: 1px solid rgba(255, 255, 255, 0.15);
	}

	.breadcrumb ol {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.breadcrumb-link {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		color: rgba(255, 255, 255, 0.8);
		text-decoration: none;
		font-size: 0.85rem;
		font-weight: 500;
		transition: color var(--transition-fast);
	}

	.breadcrumb-link:hover {
		color: var(--white);
	}

	.breadcrumb-separator {
		color: rgba(255, 255, 255, 0.4);
		display: flex;
		align-items: center;
	}

	.breadcrumb-current {
		color: var(--white);
		font-size: 0.85rem;
		font-weight: 600;
	}

	/* Label */
	.section-label {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		background: var(--white);
		padding: 0.5rem 1rem;
		border-radius: 50px;
		color: var(--green-700);
		font-size: 0.85rem;
		font-weight: 700;
		letter-spacing: 0.05em;
		box-shadow: 0 4px 15px rgba(22, 163, 74, 0.1);
		margin-bottom: 1.5rem;
	}

	/* Typography */
	.header-title {
		font-family: var(--font-heading);
		font-size: clamp(2.5rem, 4vw, 3.5rem);
		font-weight: 800;
		color: var(--white);
		line-height: 1.15;
		margin-bottom: 1.5rem;
		letter-spacing: -0.02em;
	}

	.text-accent {
		color: var(--green-400);
	}

	.header-desc {
		font-size: 1.1rem;
		line-height: 1.7;
		color: rgba(255, 255, 255, 0.9);
		margin-bottom: 1.5rem;
	}
    
    .header-microcopy {
        font-size: 0.9rem;
        line-height: 1.5;
        color: rgba(255, 255, 255, 0.6);
        margin: 0;
        font-style: italic;
    }

	/* Responsive */
	@media (max-width: 768px) {
		.sdgs-header {
			padding: 8rem 0 4rem;
		}
	}
</style>
