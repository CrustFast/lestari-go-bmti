---
const categories = [
	'Semua',
	'Penanaman Vegetasi',
	'Konservasi Hidrologi',
	'Pengelolaan Limbah & 3R',
	'Infrastruktur EBT',
	'Aksi Kolaborasi'
];

// Generate 16 items for demonstration
const galleryItems = [
	{ id: 1, category: 'Penanaman Vegetasi', image: '/img/bg-1.jpeg', title: 'Peremajaan Vegetasi Kampus', desc: 'Penataan ulang Ruang Terbuka Hijau (RTH) dan pemeliharaan pohon tua guna menjaga pasokan oksigen mikro.', date: '2026-08-12', dateStr: '12-08-2026', location: 'Zona Barat Kampus BMTI', parties: 'Staf Teknis & Mahasiswa Magang' },
	{ id: 2, category: 'Konservasi Hidrologi', image: '/img/bg-2.jpg', title: 'Sumur Resapan & Biopori', desc: 'Konstruksi 20 lubang biopori di titik rawan genangan untuk mengembalikan fungsi serapan air tanah.', date: '2026-08-25', dateStr: '25-08-2026', location: 'Area Parkir & Lapangan Olahraga', parties: 'Unit Infrastruktur & Fasilitas' },
	{ id: 3, category: 'Konservasi Hidrologi', image: '/img/bg-3.jpg', title: 'Rain Harvesting System', desc: 'Sistem pemanenan air hujan untuk menjaga siklus hidrologi dan ketersediaan air bersih di area kampus.', date: '2026-09-05', dateStr: '05-09-2026', location: 'Atap Gedung Utama BMTI', parties: 'Vendor Teknisi & Staf BMTI' },
	{ id: 4, category: 'Pengelolaan Limbah & 3R', image: '/img/abt-1.jpeg', title: 'Manajemen Sampah Organik', desc: 'Pengelolaan harian limbah hayati dari ruang terbuka hijau untuk mewujudkan target Zero-Waste.', date: '2026-09-08', dateStr: '08-09-2026', location: 'Seluruh Area Taman BMTI', parties: 'Tim Kebersihan BMTI' },
	{ id: 5, category: 'Aksi Kolaborasi', image: '/img/abt-2.jpeg', title: 'Sinergi dengan DLH Kota Cimahi', desc: 'Perawatan partisipatif kawasan hijau bersama instansi pemerintah daerah untuk pelestarian jangka panjang.', date: '2026-09-10', dateStr: '10-09-2026', location: 'Batas Luar Kampus BMTI', parties: 'BMTI & Mitra DLH Cimahi' },
	{ id: 6, category: 'Penanaman Vegetasi', image: '/img/bg-2.jpg', title: 'Edukasi Lingkungan Hijau', desc: 'Melibatkan siswa dan masyarakat sekitar dalam praktik langsung perawatan tanaman dan pemahaman ekosistem.', date: '2026-09-12', dateStr: '12-09-2026', location: 'Zona Selatan Kampus', parties: 'Peserta Diklat PjBL' },
	{ id: 7, category: 'Infrastruktur EBT', image: '/img/bg-3.jpg', title: 'Kawasan Bebas Emisi', desc: 'Penetapan zona khusus bebas kendaraan bermotor di area pusat kampus untuk menjaga kualitas udara.', date: '2026-09-15', dateStr: '15-09-2026', location: 'Jalur Utama Kampus BMTI', parties: 'Unit Keamanan & Staf BMTI' },
	{ id: 8, category: 'Pengelolaan Limbah & 3R', image: '/img/bg-1.jpeg', title: 'Bank Sampah Digital', desc: 'Penerapan sistem pemilahan sampah berbasis digital untuk efisiensi daur ulang di area kantor.', date: '2026-07-20', dateStr: '20-07-2026', location: 'Gedung Administrasi', parties: 'Staf & Pegawai BMTI' },
	{ id: 9, category: 'Infrastruktur EBT', image: '/img/abt-2.jpeg', title: 'Panel Surya Area Bengkel', desc: 'Pemasangan panel surya skala kecil untuk mendukung sebagian daya di bengkel praktik.', date: '2026-07-15', dateStr: '15-07-2026', location: 'Bengkel Teknik Mesin', parties: 'Divisi Kelistrikan BMTI' },
	{ id: 10, category: 'Penanaman Vegetasi', image: '/img/abt-1.jpeg', title: 'Greenhouse Tanaman Langka', desc: 'Pembuatan rumah kaca untuk pembibitan tanaman langka khas Jawa Barat.', date: '2026-08-05', dateStr: '05-08-2026', location: 'Kawasan Konservasi BMTI', parties: 'Tim Konservasi & Ahli Botani' },
	{ id: 11, category: 'Konservasi Hidrologi', image: '/img/bg-2.jpg', title: 'Kolam Retensi Mini', desc: 'Pembuatan kolam retensi buatan untuk menampung limpasan air permukaan saat hujan deras.', date: '2026-08-20', dateStr: '20-08-2026', location: 'Area Timur Kampus', parties: 'Divisi Infrastruktur' },
	{ id: 12, category: 'Aksi Kolaborasi', image: '/img/bg-3.jpg', title: 'Festival Hijau BMTI 2026', desc: 'Pameran inovasi lingkungan dan kompetisi kreativitas daur ulang tingkat SMK.', date: '2026-09-25', dateStr: '25-09-2026', location: 'Aula Utama & Plaza', parties: 'Panitia Khusus & Siswa SMK' },
	{ id: 13, category: 'Pengelolaan Limbah & 3R', image: '/img/bg-1.jpeg', title: 'Pelatihan Upcycling Material', desc: 'Workshop mengolah sisa material bengkel menjadi karya seni fungsional.', date: '2026-10-02', dateStr: '02-10-2026', location: 'Ruang Workshop Seni', parties: 'Instruktur & Peserta Diklat' },
	{ id: 14, category: 'Infrastruktur EBT', image: '/img/abt-1.jpeg', title: 'Lampu PJU Tenaga Surya', desc: 'Instalasi lampu penerangan jalan umum mandiri energi di sepanjang akses masuk kampus.', date: '2026-10-10', dateStr: '10-10-2026', location: 'Gerbang Utama & Akses Jalan', parties: 'Vendor EBT & Teknisi' },
	{ id: 15, category: 'Penanaman Vegetasi', image: '/img/abt-2.jpeg', title: 'Program 1000 Pohon', desc: 'Penanaman bibit pohon buah-buahan lokal untuk ketahanan pangan ekosistem.', date: '2026-11-01', dateStr: '01-11-2026', location: 'Lahan Kosong Utara', parties: 'Seluruh Sivitas Akademika' },
	{ id: 16, category: 'Aksi Kolaborasi', image: '/img/bg-2.jpg', title: 'MoU Kampus Hijau Terpadu', desc: 'Penandatanganan kerja sama antar instansi untuk komitmen keberlanjutan.', date: '2026-11-15', dateStr: '15-11-2026', location: 'Ruang Rapat Pimpinan', parties: 'Pimpinan BMTI & Stakeholder' }
];

// Sort initial items by date descending (Terbaru first)
galleryItems.sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());
---

<section class="gallery-page-content">
	<div class="gallery-container">
		<!-- Toolbar (Filters & Sort) -->
		<div class="gallery-toolbar" data-animate="fade-up">
			<div class="gallery-filters">
				{categories.map((cat, i) => (
					<button class={`filter-btn ${i === 0 ? 'active' : ''}`} data-filter={cat === 'Semua' ? 'all' : cat}>
						{cat}
					</button>
				))}
			</div>
			<div class="gallery-sort">
				<label class="sort-label">Urutkan:</label>
				<div class="custom-select-wrapper" id="custom-sort">
					<div class="custom-select-trigger" id="custom-sort-trigger">
						<span id="custom-sort-label">Terbaru</span>
						<svg class="sort-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>
					</div>
					<div class="custom-select-options" id="custom-sort-options">
						<div class="custom-select-option selected" data-value="terbaru">Terbaru</div>
						<div class="custom-select-option" data-value="terlama">Terlama</div>
					</div>
				</div>
			</div>
		</div>

		<!-- Gallery Grid -->
		<div class="gallery-grid" id="main-gallery-grid" data-animate="fade-up" data-delay="100">
			{galleryItems.map((item, index) => (
				<div class="gallery-item" data-category={item.category} data-date={item.date} style={index >= 12 ? 'display: none;' : ''}>
					<img src={item.image} alt={item.title} class="gallery-img" loading="lazy" />
					<div class="gallery-overlay">
						<div class="overlay-top-space">
							<div class="overlay-center-icon" 
								data-img={item.image} 
								data-title={item.title} 
								data-category={item.category} 
								data-desc={item.desc}
								data-date={item.dateStr}
								data-location={item.location}
								data-parties={item.parties}>
								<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17l9.2-9.2M17 17V7H7"/></svg>
							</div>
						</div>
						<div class="overlay-bottom-card">
							<span class="overlay-category">{item.category}</span>
							<h3 class="overlay-title">{item.title}</h3>
							<p class="overlay-desc">{item.desc}</p>
						</div>
					</div>
				</div>
			))}
		</div>

		<!-- Pagination / Load More -->
		<div class="pagination-wrapper" data-animate="fade-up">
			<button id="load-more-btn" class="load-more-btn">
				Muat Lebih Banyak
				<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>
			</button>
			<p id="no-more-msg" class="no-more-msg" style="display: none;">Semua galeri telah ditampilkan.</p>
		</div>
	</div>

	<!-- Lightbox -->
	<div id="gallery-lightbox" class="lightbox" data-lenis-prevent>
		<div class="lightbox-overlay" id="lightbox-close"></div>
		<div class="lightbox-content">
			<button class="lightbox-close-btn" id="lightbox-close-btn">&times;</button>
			<div class="lightbox-img-wrapper">
				<img src="" alt="Gallery Image" class="lightbox-img" id="lightbox-img" />
			</div>
			<div class="lightbox-card" id="lightbox-card" data-lenis-prevent>
				<span class="overlay-category" id="lightbox-category"></span>
				<h3 class="overlay-title" id="lightbox-title"></h3>
				<p class="overlay-desc" id="lightbox-desc"></p>
				<div class="lightbox-metadata">
					<div class="meta-item">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
						<span id="lightbox-date"></span>
					</div>
					<div class="meta-item">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
						<span id="lightbox-location"></span>
					</div>
					<div class="meta-item">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
						<span id="lightbox-parties"></span>
					</div>
				</div>
			</div>
			<button class="lightbox-toggle-card" id="lightbox-toggle-card" aria-label="Toggle Informasi">
				<svg id="icon-hide" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
				<svg id="icon-show" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none;"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
			</button>
		</div>
	</div>
</section>

<style>
	.gallery-page-content {
		padding: 4rem 0 8rem;
		background-color: var(--white);
	}

	.gallery-container {
		max-width: var(--container-max);
		margin: 0 auto;
		padding: 0 var(--container-padding);
	}

	/* Toolbar */
	.gallery-toolbar {
		display: flex;
		flex-direction: row;
		justify-content: space-between;
		align-items: center;
		flex-wrap: wrap;
		gap: 1.5rem;
		margin-bottom: 3rem;
		position: relative;
		z-index: 20;
	}

	.gallery-filters {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	.filter-btn {
		background: var(--gray-50);
		border: 1px solid var(--gray-200);
		color: var(--gray-700);
		padding: 0.6rem 1.25rem;
		border-radius: 50px;
		font-size: 0.9rem;
		font-weight: 600;
		transition: all 0.3s ease;
		cursor: pointer;
	}

	.filter-btn:hover {
		border-color: var(--green-400);
		color: var(--green-700);
		background: var(--white);
	}

	.filter-btn.active {
		background: var(--green-600);
		border-color: var(--green-600);
		color: var(--white);
		box-shadow: 0 4px 12px rgba(30, 160, 47, 0.2);
	}

	.gallery-sort {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.sort-label {
		font-size: 0.9rem;
		font-weight: 600;
		color: var(--gray-700);
	}

	.custom-select-wrapper {
		position: relative;
		user-select: none;
		min-width: 140px;
	}

	.custom-select-trigger {
		display: flex;
		justify-content: space-between;
		align-items: center;
		background: var(--white);
		border: 1px solid var(--gray-300);
		padding: 0.6rem 1.25rem;
		border-radius: 50px;
		font-size: 0.9rem;
		color: var(--gray-800);
		font-weight: 600;
		cursor: pointer;
		transition: all 0.3s ease;
	}

	.custom-select-trigger:hover, .custom-select-wrapper.open .custom-select-trigger {
		border-color: var(--green-400);
		box-shadow: 0 4px 12px rgba(30, 160, 47, 0.1);
	}

	.custom-select-wrapper.open .sort-icon {
		transform: rotate(180deg);
	}

	.sort-icon {
		color: var(--gray-500);
		transition: transform 0.3s ease;
	}

	.custom-select-options {
		position: absolute;
		top: calc(100% + 0.5rem);
		right: 0;
		background: var(--white);
		border: 1px solid var(--gray-200);
		border-radius: 12px;
		box-shadow: 0 10px 25px rgba(0,0,0,0.1);
		overflow: hidden;
		width: 100%;
		opacity: 0;
		visibility: hidden;
		transform: translateY(-10px);
		transition: all 0.3s ease;
		z-index: 10;
	}

	.custom-select-wrapper.open .custom-select-options {
		opacity: 1;
		visibility: visible;
		transform: translateY(0);
	}

	.custom-select-option {
		padding: 0.75rem 1.25rem;
		font-size: 0.9rem;
		font-weight: 500;
		color: var(--gray-700);
		cursor: pointer;
		transition: background 0.2s ease, color 0.2s ease;
	}

	.custom-select-option:hover {
		background: var(--gray-50);
		color: var(--green-600);
	}

	.custom-select-option.selected {
		background: var(--green-50);
		color: var(--green-700);
		font-weight: 600;
	}

	/* Grid */
	.gallery-grid {
		display: grid;
		grid-template-columns: repeat(1, 1fr);
		gap: 1.5rem;
	}

	@media (min-width: 640px) {
		.gallery-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (min-width: 1024px) {
		.gallery-grid {
			grid-template-columns: repeat(4, 1fr);
		}
	}

	.gallery-item {
		position: relative;
		border-radius: 16px;
		overflow: hidden;
		aspect-ratio: 4 / 5;
		cursor: pointer;
		transform: scale(1);
		opacity: 1;
		transition: transform 0.4s ease, opacity 0.4s ease;
	}

	.gallery-item.hidden-by-filter {
		display: none !important;
	}

	.gallery-item.hidden-by-pagination {
		display: none !important;
	}

	.gallery-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
	}

	/* Hover Effects */
	.gallery-item:hover .gallery-img {
		transform: scale(1.1);
	}

	.gallery-overlay {
		position: absolute;
		inset: 0;
		background: rgba(10, 46, 20, 0.5); /* Dark green overlay */
		opacity: 0;
		display: flex;
		flex-direction: column;
		padding: 1rem;
		transition: opacity 0.4s ease;
	}

	.gallery-item:hover .gallery-overlay {
		opacity: 1;
	}

	.overlay-top-space {
		flex: 1;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.overlay-center-icon {
		width: 56px;
		height: 56px;
		background: var(--green-500);
		color: var(--white);
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		transform: translateY(20px) scale(0.8);
		opacity: 0;
		cursor: pointer;
		transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
	}

	.gallery-item:hover .overlay-center-icon {
		transform: translateY(0) scale(1);
		opacity: 1;
	}

	.overlay-center-icon:hover {
		transform: translateY(0) scale(1.15) !important;
		background: var(--green-600);
		box-shadow: 0 4px 15px rgba(34, 197, 94, 0.4);
	}

	.overlay-bottom-card {
		background: var(--white);
		padding: 1.25rem;
		border-radius: 12px;
		transform: translateY(20px);
		opacity: 0;
		transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1) 0.1s;
	}

	.gallery-item:hover .overlay-bottom-card {
		transform: translateY(0);
		opacity: 1;
	}

	.overlay-category {
		display: block;
		font-size: 0.75rem;
		font-weight: 700;
		color: var(--green-600);
		text-transform: uppercase;
		letter-spacing: 0.05em;
		margin-bottom: 0.25rem;
	}

	.overlay-title {
		font-size: 1.1rem;
		font-weight: 700;
		color: var(--gray-900);
		margin-bottom: 0.5rem;
	}

	.overlay-desc {
		font-size: 0.85rem;
		color: var(--gray-600);
		line-height: 1.5;
		margin: 0;
	}

	/* Pagination */
	.pagination-wrapper {
		display: flex;
		flex-direction: column;
		align-items: center;
		margin-top: 4rem;
	}

	.load-more-btn {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		background: var(--white);
		color: var(--green-600);
		border: 1px solid var(--green-600);
		padding: 0.875rem 2rem;
		border-radius: 50px;
		font-weight: 600;
		font-size: 1rem;
		cursor: pointer;
		transition: all 0.3s ease;
	}

	.load-more-btn:hover {
		background: var(--green-600);
		color: var(--white);
		transform: translateY(-2px);
		box-shadow: 0 4px 15px rgba(22, 163, 74, 0.2);
	}

	.no-more-msg {
		color: var(--gray-500);
		font-size: 0.95rem;
		font-style: italic;
	}

	/* Lightbox */
	.lightbox {
		position: fixed;
		inset: 0;
		z-index: 9999;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 2rem;
		opacity: 0;
		visibility: hidden;
		transition: opacity 0.4s ease, visibility 0.4s ease;
	}

	.lightbox.active {
		opacity: 1;
		visibility: visible;
	}

	.lightbox-overlay {
		position: absolute;
		inset: 0;
		background: rgba(0, 0, 0, 0.85);
		backdrop-filter: blur(4px);
	}

	.lightbox-content {
		position: relative;
		z-index: 1;
		width: 90vw;
		max-width: 1000px;
		height: 80vh;
		display: flex;
		justify-content: center;
		align-items: center;
		transform: scale(0.9);
		opacity: 0;
		transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
	}

	.lightbox.active .lightbox-content {
		transform: scale(1);
		opacity: 1;
	}

	.lightbox-img-wrapper {
		width: 100%;
		height: 100%;
		border-radius: 12px;
		overflow: hidden;
		box-shadow: 0 10px 40px rgba(0,0,0,0.5);
	}

	.lightbox-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.lightbox-card {
		position: absolute;
		bottom: 1.5rem;
		left: 1.5rem;
		background: var(--white);
		padding: 1.5rem;
		border-radius: 12px;
		width: 100%;
		max-width: 400px;
		box-shadow: 0 10px 30px rgba(0,0,0,0.25);
		transition: transform 0.4s ease, opacity 0.4s ease;
	}

	.lightbox-card.hidden {
		opacity: 0;
		transform: translateY(20px);
		pointer-events: none;
	}

	.lightbox-toggle-card {
		position: absolute;
		bottom: 1.5rem;
		right: 1.5rem;
		background: rgba(0,0,0,0.6);
		color: white;
		border: none;
		width: 44px;
		height: 44px;
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		cursor: pointer;
		backdrop-filter: blur(4px);
		transition: background 0.3s;
		z-index: 2;
	}

	.lightbox-toggle-card:hover {
		background: rgba(0,0,0,0.8);
	}

	.lightbox-close-btn {
		position: absolute;
		top: -2.5rem;
		right: -2rem;
		background: transparent;
		border: none;
		color: white;
		font-size: 2.5rem;
		cursor: pointer;
		line-height: 1;
		transition: transform 0.3s;
	}

	.lightbox-close-btn:hover {
		transform: scale(1.15) rotate(90deg);
	}

	.lightbox-metadata {
		margin-top: 1.25rem;
		padding-top: 1rem;
		border-top: 1px solid var(--gray-200);
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
	}

	.meta-item {
		display: flex;
		align-items: flex-start;
		gap: 0.6rem;
		font-size: 0.85rem;
		color: var(--gray-700);
		line-height: 1.4;
	}

	.meta-item svg {
		color: var(--green-600);
		flex-shrink: 0;
		margin-top: 2px;
	}

	@media (max-width: 768px) {
		.lightbox-close-btn {
			top: -2.5rem;
			right: 0;
		}
		.lightbox-card {
			top: auto;
			bottom: 1.5rem;
			left: 1.5rem;
			right: 1.5rem;
			max-width: none;
		}
	}

</style>

<script>
	document.addEventListener('DOMContentLoaded', () => {
		const grid = document.getElementById('main-gallery-grid');
		if (!grid) return;

		let galleryItems = Array.from(grid.querySelectorAll('.gallery-item'));
		const filterBtns = document.querySelectorAll('.filter-btn');
		const loadMoreBtn = document.getElementById('load-more-btn');
		const noMoreMsg = document.getElementById('no-more-msg');

		let currentFilter = 'all';
		let currentSort = 'terbaru';
		const itemsPerPage = 12;
		let visibleCount = itemsPerPage;

		// --- Core Logic: Render grid based on filter, sort, and pagination ---
		const updateGallery = () => {
			// 1. Filter
			let filtered = galleryItems.filter(item => {
				const itemCategory = item.getAttribute('data-category');
				return currentFilter === 'all' || currentFilter === itemCategory;
			});

			// 2. Sort
			filtered.sort((a, b) => {
				const dateA = new Date(a.getAttribute('data-date') || 0).getTime();
				const dateB = new Date(b.getAttribute('data-date') || 0).getTime();
				return currentSort === 'terbaru' ? dateB - dateA : dateA - dateB;
			});

			// 3. Re-append in sorted order (DOM manipulation)
			filtered.forEach(item => grid.appendChild(item));

			// 4. Apply pagination classes
			galleryItems.forEach(item => {
				item.classList.add('hidden-by-filter'); // hide all initially
				item.classList.remove('hidden-by-pagination'); 
			});

			filtered.forEach((item, index) => {
				item.classList.remove('hidden-by-filter'); // show filtered
				if (index >= visibleCount) {
					item.classList.add('hidden-by-pagination'); // hide if beyond pagination
				}
			});

			// 5. Update Load More button state
			if (loadMoreBtn && noMoreMsg) {
				if (filtered.length <= visibleCount) {
					loadMoreBtn.style.display = 'none';
					if(filtered.length > 0) {
						noMoreMsg.style.display = 'block';
					} else {
						noMoreMsg.style.display = 'none'; // No items at all for this filter
					}
				} else {
					loadMoreBtn.style.display = 'flex';
					noMoreMsg.style.display = 'none';
				}
			}
		};

		// --- Event Listeners ---
		
		// Filter
		filterBtns.forEach(btn => {
			btn.addEventListener('click', () => {
				filterBtns.forEach(b => b.classList.remove('active'));
				btn.classList.add('active');
				currentFilter = btn.getAttribute('data-filter') || 'all';
				visibleCount = itemsPerPage; // Reset pagination on filter change
				updateGallery();
			});
		});

		// Custom Sort
		const customSortWrapper = document.getElementById('custom-sort');
		const customSortTrigger = document.getElementById('custom-sort-trigger');
		const customSortLabel = document.getElementById('custom-sort-label');
		const customSortOptions = document.querySelectorAll('.custom-select-option');

		if (customSortTrigger) {
			customSortTrigger.addEventListener('click', (e) => {
				e.stopPropagation();
				customSortWrapper.classList.toggle('open');
			});
		}

		customSortOptions.forEach(option => {
			option.addEventListener('click', (e) => {
				e.stopPropagation();
				customSortOptions.forEach(opt => opt.classList.remove('selected'));
				option.classList.add('selected');
				
				const value = option.getAttribute('data-value');
				const text = option.textContent;
				
				if (customSortLabel) customSortLabel.textContent = text;
				if (customSortWrapper) customSortWrapper.classList.remove('open');
				
				currentSort = value;
				visibleCount = itemsPerPage;
				updateGallery();
			});
		});

		// Close dropdown when clicking outside
		document.addEventListener('click', () => {
			if (customSortWrapper) customSortWrapper.classList.remove('open');
		});

		// Load More
		if (loadMoreBtn) {
			loadMoreBtn.addEventListener('click', () => {
				visibleCount += itemsPerPage;
				updateGallery();
			});
		}

		// Initial Run
		updateGallery();

		// --- Lightbox logic (copied from GallerySection) ---
		const lightbox = document.getElementById('gallery-lightbox');
		const lightboxImg = document.getElementById('lightbox-img');
		const lightboxCategory = document.getElementById('lightbox-category');
		const lightboxTitle = document.getElementById('lightbox-title');
		const lightboxDesc = document.getElementById('lightbox-desc');
		const lightboxDate = document.getElementById('lightbox-date');
		const lightboxLocation = document.getElementById('lightbox-location');
		const lightboxParties = document.getElementById('lightbox-parties');
		const lightboxCloseBtn = document.getElementById('lightbox-close-btn');
		const lightboxOverlay = document.getElementById('lightbox-close');
		const lightboxCard = document.getElementById('lightbox-card');
		const lightboxToggle = document.getElementById('lightbox-toggle-card');
		const iconHide = document.getElementById('icon-hide');
		const iconShow = document.getElementById('icon-show');

		// Use event delegation for dynamically sorted items
		grid.addEventListener('click', (e) => {
			const target = e.target as HTMLElement;
			const icon = target.closest('.overlay-center-icon');
			
			if (icon) {
				e.preventDefault();
				if (lightboxImg) lightboxImg.setAttribute('src', icon.getAttribute('data-img') || '');
				if (lightboxCategory) lightboxCategory.textContent = icon.getAttribute('data-category');
				if (lightboxTitle) lightboxTitle.textContent = icon.getAttribute('data-title');
				if (lightboxDesc) lightboxDesc.textContent = icon.getAttribute('data-desc');
				if (lightboxDate) lightboxDate.textContent = icon.getAttribute('data-date');
				if (lightboxLocation) lightboxLocation.textContent = icon.getAttribute('data-location');
				if (lightboxParties) lightboxParties.textContent = icon.getAttribute('data-parties');
				if (lightbox) lightbox.classList.add('active');
			}
		});

		if (lightboxToggle && lightboxCard && iconHide && iconShow) {
			lightboxToggle.addEventListener('click', (e) => {
				e.stopPropagation();
				lightboxCard.classList.toggle('hidden');
				if (lightboxCard.classList.contains('hidden')) {
					iconHide.style.display = 'none';
					iconShow.style.display = 'block';
				} else {
					iconHide.style.display = 'block';
					iconShow.style.display = 'none';
				}
			});
		}

		const closeLightbox = () => {
			if (lightbox) lightbox.classList.remove('active');
			setTimeout(() => {
				if (lightboxImg) lightboxImg.setAttribute('src', '');
				// Reset toggle state
				if (lightboxCard) lightboxCard.classList.remove('hidden');
				if (iconHide) iconHide.style.display = 'block';
				if (iconShow) iconShow.style.display = 'none';
			}, 400);
		};

		if (lightboxCloseBtn) lightboxCloseBtn.addEventListener('click', closeLightbox);
		if (lightboxOverlay) lightboxOverlay.addEventListener('click', closeLightbox);
	});
</script>
