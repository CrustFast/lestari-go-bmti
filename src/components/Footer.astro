<style>
	.site-footer {
		background-color: var(--white);
		padding: 4rem 0 2rem;
		border-top: 1px solid var(--gray-100);
	}

	.footer-container {
		max-width: var(--container-max);
		margin: 0 auto;
		padding: 0 var(--container-padding);
	}

	/* Top Grid */
	.footer-top {
		display: grid;
		grid-template-columns: 1fr;
		gap: 3rem;
		margin-bottom: 4rem;
	}

	@media (min-width: 768px) {
		.footer-top {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (min-width: 1024px) {
		.footer-top {
			grid-template-columns: 2fr 1.5fr 1.5fr 1.5fr;
			gap: 4rem;
		}
	}

	/* Column 1: Brand */
	.footer-logo {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin-bottom: 1.25rem;
	}

	.logo-text {
		display: flex;
		flex-direction: column;
	}

	.logo-title {
		font-family: var(--font-heading);
		font-size: 1.25rem;
		font-weight: 800;
		color: var(--green-700);
		line-height: 1.1;
	}

	.logo-subtitle {
		font-size: 0.75rem;
		font-weight: 600;
		color: var(--gray-500);
	}

	.footer-desc {
		font-size: 0.85rem;
		line-height: 1.6;
		color: var(--gray-500);
		margin-bottom: 1.5rem;
	}

	.footer-badge {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		background-color: #f0f4f8; /* Light bluish gray */
		color: #334155; /* Dark slate */
		padding: 0.5rem 0.85rem;
		border-radius: 50px;
		font-size: 0.75rem;
		font-weight: 700;
	}

	/* Columns 2-4 */
	.footer-heading {
		font-size: 1.05rem;
		font-weight: 700;
		color: var(--gray-800);
		margin-bottom: 1.5rem;
	}

	.mb-4 {
		margin-bottom: 1.25rem;
	}

	.footer-list {
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}

	.footer-list li {
		display: flex;
		align-items: flex-start;
		gap: 0.75rem;
	}

	.list-icon {
		color: var(--green-600);
		margin-top: 0.15rem; /* alignment with text */
		flex-shrink: 0;
	}

	.list-text {
		font-size: 0.85rem;
		line-height: 1.6;
		color: var(--gray-600);
	}

	.text-green {
		color: var(--green-600);
		font-weight: 600;
		display: block;
		margin-top: 0.25rem;
	}

	/* Links column */
	:global(.footer-social) {
		display: flex;
		flex-direction: row;
		gap: 1.25rem;
		/* margin-top: 1.5rem; */
	}

	:global(.footer-social a) {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 44px;
		height: 44px;
		border-radius: 50%;
		/* background-color: var(--green-100); */
		color: var(--green-600) !important;
		text-decoration: none;
		transition: all 0.3s ease;
	}

	:global(.footer-social a:hover) {
		background-color: var(--green-600) !important;
		color: var(--white) !important;
		transform: translateY(-3px);
		box-shadow: 0 4px 12px rgba(30, 160, 47, 0.2);
	}

	:global(.footer-social a svg) {
		stroke: currentColor;
		transition: color 0.3s ease;
	}

	/* Bottom Bar */
	.footer-bottom {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
		padding-top: 2rem;
		border-top: 1px solid var(--gray-200);
		font-size: 0.8rem;
		color: var(--gray-500);
	}

	@media (min-width: 768px) {
		.footer-bottom {
			flex-direction: row;
			justify-content: space-between;
			align-items: center;
		}
	}

	.footer-legal {
		display: flex;
		flex-wrap: wrap;
		gap: 1.5rem;
	}

	.footer-legal a {
		color: var(--gray-500);
		text-decoration: none;
		font-weight: 500;
		transition: color 0.2s ease;
	}

	.footer-legal a:hover {
		color: var(--green-600);
	}
</style>
