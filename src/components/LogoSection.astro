---
import { Image } from 'astro:assets';
import logo1 from '../assets/img/logo/tut-wuri-handayani.png';
import logo2 from '../assets/img/logo/Logo-Cimahi.png';
import logo3 from '../assets/img/logo/logo 1.png';
---
<section class="logo-section" data-animate="fade-up">
	<div class="logo-container">
		<Image src={logo1} alt="Tut Wuri Handayani" class="partner-logo logo-kemdikbud" loading="lazy" />
		<Image src={logo2} alt="Dinas Lingkungan Hidup Cimahi" class="partner-logo logo-cimahi" loading="lazy" />
		<Image src={logo3} alt="Indonesia Asri" class="partner-logo logo-asri" loading="lazy" />
	</div>
</section>

<style>
	.logo-section {
		padding: 4rem var(--container-padding);
		background: var(--white);
	}

	.logo-container {
		max-width: var(--container-max);
		margin: 0 auto;
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		align-items: center;
		gap: 1.5rem;
	}

	.partner-logo {
		opacity: 0.6;
		transition: opacity var(--transition-base), transform var(--transition-base), filter var(--transition-base);
		filter: grayscale(100%);
		object-fit: contain;
		width: auto;
	}

	/* Individual sizing for visual balance (mobile base) */
	.logo-kemdikbud { height: 55px; }
	.logo-cimahi { height: 55px; } 
	.logo-asri { height: 55px; }
	.logo-dudi { height: 48px; }

	.partner-logo:hover {
		opacity: 1;
		filter: grayscale(0%);
		transform: translateY(-2px);
	}

	@media (min-width: 768px) {
		.logo-container {
			justify-content: center;
			gap: 10rem;
		}
		
		/* Visual balance for desktop */
		.logo-kemdikbud { height: 80px; }
		.logo-cimahi { height: 80px; }
		.logo-asri { height: 80px; }
		.logo-dudi { height: 70px; }
	}
</style>
