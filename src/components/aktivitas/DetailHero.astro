---
const { article } = Astro.props;

import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/img/*.{jpeg,jpg,png,gif,webp,JPG,JPEG,PNG}');
---

<section class="detail-hero">
    <div class="hero-bg">
        <Image src={images[article.image]()} alt="Background" class="bg-img" />
        <div class="overlay"></div>
    </div>
    
    <div class="hero-container">
        <!-- Breadcrumbs -->
        <nav class="breadcrumbs" aria-label="Breadcrumb">
            <ol>
                <li><a href="/">Beranda</a></li>
                <li class="separator">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
                </li>
                <li><a href="/aktivitas">Aktivitas</a></li>
                <li class="separator">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
                </li>
                <li class="current" aria-current="page">{article.category}</li>
            </ol>
        </nav>

        <!-- Title -->
        <h1 class="article-title">{article.title}</h1>

        <!-- Meta Info & Share -->
        <div class="hero-meta-wrapper">
            <div class="meta-info">
                <div class="meta-item">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
                    <span>{article.date}</span>
                </div>
                <div class="meta-divider">|</div>
                <div class="meta-item">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                    <span>Penulis: {article.author}</span>
                </div>
                <div class="meta-divider">|</div>
                <div class="meta-item">
                    <span>Editor: {article.editor}</span>
                </div>
            </div>

            <div class="meta-stats">
                <div class="meta-item">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                    <div class="stat-text">
                        <span class="stat-val">{article.views}</span>
                        <span class="stat-label">Dilihat</span>
                    </div>
                </div>
                <div class="meta-divider">|</div>
                <div class="meta-item">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                    <div class="stat-text">
                        <span class="stat-val">0 Kali</span>
                        <span class="stat-label">Dibagikan</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Floating Share Actions (Right Edge) -->
        <div class="floating-actions">
            <button class="action-btn" aria-label="Share">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" x2="15.42" y1="13.51" y2="17.49"/><line x1="15.41" x2="8.59" y1="6.51" y2="10.49"/></svg>
            </button>
            <button class="action-btn" aria-label="Print">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect width="12" height="8" x="6" y="14"/></svg>
            </button>
        </div>
    </div>
</section>

<style>
    .detail-hero {
        position: relative;
        padding-top: 140px; /* Space for navbar */
        padding-bottom: 3.5rem;
        min-height: 360px;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        color: var(--white);
    }

    /* Background Setup */
    .hero-bg {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: 0;
        overflow: hidden;
    }

    .bg-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center 25%;
    }

    .overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(
            to right,
            rgba(10, 46, 20, 0.9) 0%,
            rgba(10, 46, 20, 0.7) 50%,
            rgba(10, 46, 20, 0.8) 100%
        );
    }

    /* Container */
    .hero-container {
        max-width: var(--container-max);
        margin: 0 auto;
        padding: 0 var(--container-padding);
        width: 100%;
        position: relative;
        z-index: 1;
    }

    /* Breadcrumbs */
    .breadcrumbs {
        margin-bottom: 1.5rem;
    }

    .breadcrumbs ol {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.5rem;
        list-style: none;
        padding: 0;
        margin: 0;
        font-size: 0.9rem;
        font-weight: 500;
        color: var(--green-300);
    }

    .breadcrumbs a {
        color: var(--green-300);
        text-decoration: none;
        transition: color 0.2s ease;
    }

    .breadcrumbs a:hover {
        color: var(--white);
    }

    .breadcrumbs .separator {
        display: flex;
        align-items: center;
        color: rgba(255, 255, 255, 0.5);
    }

    .breadcrumbs .current {
        color: var(--white);
    }

    /* Title */
    .article-title {
        font-family: var(--font-heading);
        font-size: clamp(1.35rem, 2.75vw, 2rem);
        line-height: 1.2;
        font-weight: 700;
        margin: 0 0 2rem 0;
        max-width: 900px;
        text-wrap: balance;
    }

    /* Meta Info */
    .hero-meta-wrapper {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    @media (min-width: 768px) {
        .hero-meta-wrapper {
            padding-right: 5rem; /* Space for floating buttons */
        }
    }

    .meta-info, .meta-stats {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 1rem;
        font-size: 0.9rem;
        color: rgba(255, 255, 255, 0.8);
    }

    .meta-stats {
        padding-top: 1.25rem; /* Increased top padding for larger gap */
    }

    .meta-item {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .meta-divider {
        color: rgba(255, 255, 255, 0.3);
    }

    .stat-text {
        display: flex;
        flex-direction: column;
        line-height: 1.2;
    }

    .stat-val {
        font-weight: 700;
        color: var(--white);
    }

    .stat-label {
        font-size: 0.75rem;
        color: rgba(255, 255, 255, 0.6);
    }

    /* Floating Actions */
    .floating-actions {
        display: none;
    }

    @media (min-width: 1024px) {
        .floating-actions {
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
            position: absolute;
            right: var(--container-padding);
            bottom: 0;
            align-items: flex-end;
        }

        .action-btn {
            width: 44px;
            height: 44px;
            border-radius: 50%;
            background: var(--green-600);
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            border: none;
            cursor: pointer;
            transition: all 0.2s ease;
            box-shadow: 0 4px 10px rgba(0,0,0,0.15);
            position: relative;
            z-index: 2;
        }

        .action-btn:hover {
            background: var(--green-500);
            transform: scale(1.05) translateY(-2px);
        }
    }
</style>
