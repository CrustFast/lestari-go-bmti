---
import { Image } from 'astro:assets';
import img1 from '../assets/img/blog-02/image5.jpg';
import img2 from '../assets/img/blog-01/20250416_094019.jpg';
import img3 from '../assets/img/blog-02/image1.jpg';
import img4 from '../assets/img/blog-02/image3.jpg';
import img5 from '../assets/img/blog-06/20260916_073517.jpg';
import bh1 from '../assets/img/blog-03/buah Keben.jpg';
import bh2 from '../assets/img/blog-04/20260915_164615.jpg';
import bh3 from '../assets/img/blog-05/20260915_072118.jpg';
import bh4 from '../assets/img/blog-05/buah roda.jpg';

const categories = [
	'Semua',
	'Keragaman Hayati',
	'Penanaman Vegetasi',
	'Konservasi Hidrologi',
	'Aksi Kolaborasi',
	'Penguatan SDM'
];

const galleryItems = [
	{ category: 'Konservasi Hidrologi', image: img1, title: 'Pemasangan Biopori', desc: 'Pemasangan Biopori oleh Dirjen PMPK dan Kepala BBPPMPV BMTI.', date: '04-06-2026', location: 'Kampus BMTI', parties: 'Dirjen PMPK dan Kepala BBPPMPV BMTI' },
	{ category: 'Penguatan SDM', image: img2, title: 'Peserta sedang merakit minatur Hybrid PLTS', desc: 'Siswa diajak merakit miniatur panel surya dan menangkap sinar matahari untuk menyalakan kipas kecil.', date: '25-08-2026', location: 'BBPPMPV BMTI', parties: 'Siswi SD CIKAL SERPONG' },
	{ category: 'Penanaman Vegetasi', image: img3, title: 'Penanaman Kemiri Sunan', desc: 'Penanaman Kemiri Sunan oleh Dirjen PMPK dan Kepala BBPPMPV BMTI.', date: '04-06-2026', location: 'Kampus BMTI', parties: 'Dirjen PMPK dan Kepala BBPPMPV BMTI' },
	{ category: 'Keragaman Hayati', image: img4, title: 'Pelepasan Burung Kutilang', desc: 'Pelepasan Burung Kutilang oleh Dirjen PMPK dan Kepala BBPPMPV BMTI', date: '04-06-2026', location: 'Kampus BMTI', parties: 'Dirjen PMPK dan Kepala BBPPMPV BMTI' },
	{ category: 'Keragaman Hayati', image: img5, title: 'Buah Kepel', desc: 'Buahnya berbentuk bulat lonjong menyerupai sawo berukuran besar dengan warna cokelat keabu-abuan saat muda dan berubah menjadi cokelat tua ketika matang.', date: '10-09-2026', location: 'Kampus BMTI', parties: 'Tim Green Office BMTI' },
	{ category: 'Keragaman Hayati', image: bh1, title: 'Buah Keben', desc: 'Koleksi flora BMTI.', date: '15-09-2026', location: 'Kampus BMTI', parties: 'Tim Green Office BMTI' },
	{ category: 'Keragaman Hayati', image: bh2, title: 'Pohon Kemiri Sunan', desc: 'Tanaman penghasil energi biomassa.', date: '15-09-2026', location: 'Kampus BMTI', parties: 'Tim Green Office BMTI' },
	{ category: 'Keragaman Hayati', image: bh3, title: 'Hura crepitans', desc: 'Pohon purba di ruang hijau BMTI.', date: '15-09-2026', location: 'Kampus BMTI', parties: 'Tim Green Office BMTI' },
	{ category: 'Keragaman Hayati', image: bh4, title: 'Buah Roda Hura', desc: 'Karakteristik buah berdaya ledak tinggi.', date: '15-09-2026', location: 'Kampus BMTI', parties: 'Tim Green Office BMTI' }
];
---

<section id="konservasi" class="gallery-section">
	<div class="gallery-container">
		<!-- Header (Centered) -->
		<div class="gallery-header" data-animate="fade-up">
			<div class="section-label">
				<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/>
					<path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/>
				</svg>
				Konservasi & Ekosistem
			</div>
			<h2 class="section-heading">
				Menjaga Harmoni Alam:<br>
				<span class="heading-light">Ruang Terbuka Hijau BMTI</span>
			</h2>
			<p class="section-description">
				Jelajahi langkah nyata kami dalam merawat ekosistem seluas 130.976 m². Mengubah setiap jengkal lahan menjadi kawasan konservasi yang asri, produktif, dan selaras dengan alam.
			</p>
		</div>

		<!-- Filters -->
		<div class="gallery-filters" data-animate="fade-up" data-delay="100">
			{categories.map((cat, i) => (
				<button class={`filter-btn ${i === 0 ? 'active' : ''}`} data-filter={cat === 'Semua' ? 'all' : cat}>
					{cat}
				</button>
			))}
		</div>

		<!-- Grid -->
		<div class="gallery-grid" data-animate="fade-up" data-delay="200">
			{galleryItems.slice(0, 7).map(item => (
				<div class="gallery-item" data-category={item.category}>
					<Image src={item.image} alt={item.title} class="gallery-img" loading="lazy" />
					<div class="gallery-overlay">
						<div class="overlay-top-space">
							<div class="overlay-center-icon" 
								data-img={item.image.src} 
								data-title={item.title} 
								data-category={item.category} 
								data-desc={item.desc}
								data-date={item.date}
								data-location={item.location}
								data-parties={item.parties}>
								<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17l9.2-9.2M17 17V7H7"/></svg>
							</div>
						</div>
						<div class="overlay-bottom-card">
							<span class="overlay-category">{item.category}</span>
							<h3 class="overlay-title">{item.title}</h3>
							<p class="overlay-desc">{item.desc}</p>
						</div>
					</div>
				</div>
			))}
			<!-- View All Card -->
			<a href="/galeri" class="gallery-item view-all-card" data-category="Semua">
				<div class="view-all-content">
					<div class="view-all-icon">
						<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
					</div>
					<h3 class="view-all-text">Lihat semua galeri</h3>
				</div>
			</a>
		</div>
	</div>

	<!-- Lightbox -->
	<div id="gallery-lightbox" class="lightbox" data-lenis-prevent>
		<div class="lightbox-overlay" id="lightbox-close"></div>
		<div class="lightbox-content">
			<button class="lightbox-close-btn" id="lightbox-close-btn">&times;</button>
			<div class="lightbox-img-wrapper">
				<img src="" alt="Gallery Image" class="lightbox-img" id="lightbox-img" />
			</div>
			<div class="lightbox-card" id="lightbox-card" data-lenis-prevent>
				<span class="overlay-category" id="lightbox-category"></span>
				<h3 class="overlay-title" id="lightbox-title"></h3>
				<p class="overlay-desc" id="lightbox-desc"></p>
				<div class="lightbox-metadata">
					<div class="meta-item">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
						<span id="lightbox-date"></span>
					</div>
					<div class="meta-item">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
						<span id="lightbox-location"></span>
					</div>
					<div class="meta-item">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
						<span id="lightbox-parties"></span>
					</div>
				</div>
			</div>
			<button class="lightbox-toggle-card" id="lightbox-toggle-card" aria-label="Toggle Informasi">
				<svg id="icon-hide" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
				<svg id="icon-show" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none;"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
			</button>
		</div>
	</div>
</section>

<style>
	.gallery-section {
		padding: 5rem 0 6rem;
		background-color: var(--white);
	}

	.gallery-container {
		max-width: var(--container-max);
		margin: 0 auto;
		padding: 0 var(--container-padding);
	}

	/* Header */
	.gallery-header {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		margin-bottom: 3rem;
	}

	.section-label {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		color: var(--green-600);
		font-weight: 700;
		font-size: 0.8rem;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		margin-bottom: 1rem;
	}

	.section-heading {
		font-family: var(--font-heading);
		font-size: clamp(2rem, 3.5vw, 2.75rem);
		font-weight: 800;
		color: var(--green-900);
		line-height: 1.2;
		margin-bottom: 1.25rem;
		letter-spacing: -0.02em;
	}

	.heading-light {
		color: var(--gray-400);
	}

	.section-description {
		font-size: 1.05rem;
		line-height: 1.7;
		color: var(--gray-600);
		max-width: 700px;
		margin: 0 auto;
	}

	/* Filters */
	.gallery-filters {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.75rem;
		margin-bottom: 3rem;
	}

	.filter-btn {
		background: var(--white);
		border: 1px solid var(--gray-200);
		color: var(--gray-700);
		padding: 0.6rem 1.25rem;
		border-radius: 50px;
		font-size: 0.9rem;
		font-weight: 600;
		transition: all 0.3s ease;
	}

	.filter-btn:hover {
		border-color: var(--green-400);
		color: var(--green-700);
	}

	.filter-btn.active {
		background: var(--green-600);
		border-color: var(--green-600);
		color: var(--white);
		box-shadow: 0 4px 12px rgba(30, 160, 47, 0.2);
	}

	/* Grid */
	.gallery-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
		gap: 1.5rem;
	}

	.gallery-item {
		position: relative;
		border-radius: 16px;
		overflow: hidden;
		aspect-ratio: 4 / 5;
		cursor: pointer;
		/* Default state for filtering animation */
		transform: scale(1);
		opacity: 1;
		transition: transform 0.4s ease, opacity 0.4s ease;
	}

	.gallery-item.hidden {
		display: none;
	}

	.gallery-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
	}

	/* View All Card */
	.view-all-card {
		background: var(--green-50, #f0fdf4);
		color: var(--green-600);
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		text-decoration: none;
		border: 1px dashed var(--green-200, #bbf7d0);
	}

	.view-all-card:hover {
		background: var(--green-600);
		color: var(--white);
		border-color: var(--green-600);
		transform: translateY(-5px);
	}

	.view-all-content {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1.5rem;
	}

	.view-all-icon {
		width: 72px;
		height: 72px;
		background: var(--green-600);
		color: var(--white);
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		transition: transform 0.4s ease, box-shadow 0.4s ease, background 0.4s ease, color 0.4s ease;
		box-shadow: 0 0 0 0 rgba(22, 163, 74, 0.4);
		animation: pulse-green 2s infinite;
	}

	.view-all-card:hover .view-all-icon {
		background: var(--white);
		color: var(--green-600);
		transform: translateX(10px) scale(1);
		box-shadow: 0 15px 25px rgba(0, 0, 0, 0.15);
		animation: none;
	}

	.view-all-text {
		font-size: 1.25rem;
		font-weight: 700;
		color: inherit;
		text-align: center;
		line-height: 1.4;
	}

	@keyframes pulse-green {
		0% {
			transform: scale(0.95);
			box-shadow: 0 0 0 0 rgba(22, 163, 74, 0.4);
		}
		70% {
			transform: scale(1);
			box-shadow: 0 0 0 15px rgba(22, 163, 74, 0);
		}
		100% {
			transform: scale(0.95);
			box-shadow: 0 0 0 0 rgba(22, 163, 74, 0);
		}
	}

	/* Hover Effects */
	.gallery-item:hover .gallery-img {
		transform: scale(1.1);
	}

	.gallery-overlay {
		position: absolute;
		inset: 0;
		background: rgba(10, 46, 20, 0.5); /* Dark green overlay */
		opacity: 0;
		display: flex;
		flex-direction: column;
		padding: 1rem;
		transition: opacity 0.4s ease;
	}

	.gallery-item:hover .gallery-overlay {
		opacity: 1;
	}

	.overlay-top-space {
		flex: 1;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.overlay-center-icon {
		width: 56px;
		height: 56px;
		background: var(--green-500);
		color: var(--white);
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		transform: translateY(20px) scale(0.8);
		opacity: 0;
		cursor: pointer;
		transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
	}

	.gallery-item:hover .overlay-center-icon {
		transform: translateY(0) scale(1);
		opacity: 1;
	}

	.overlay-center-icon:hover {
		transform: translateY(0) scale(1.15) !important;
		background: var(--green-600);
		box-shadow: 0 4px 15px rgba(34, 197, 94, 0.4);
	}

	.overlay-bottom-card {
		background: var(--white);
		padding: 1.25rem;
		border-radius: 12px;
		transform: translateY(20px);
		opacity: 0;
		transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1) 0.1s; /* Slight delay */
	}

	.gallery-item:hover .overlay-bottom-card {
		transform: translateY(0);
		opacity: 1;
	}

	.overlay-category {
		display: block;
		font-size: 0.75rem;
		font-weight: 700;
		color: var(--green-600);
		text-transform: uppercase;
		letter-spacing: 0.05em;
		margin-bottom: 0.25rem;
	}

	.overlay-title {
		font-size: 1.1rem;
		font-weight: 700;
		color: var(--gray-900);
		margin-bottom: 0.5rem;
	}

	.overlay-desc {
		font-size: 0.85rem;
		color: var(--gray-600);
		line-height: 1.5;
		margin: 0;
	}

	/* Lightbox */
	.lightbox {
		position: fixed;
		inset: 0;
		z-index: 9999;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 2rem;
		opacity: 0;
		visibility: hidden;
		transition: opacity 0.4s ease, visibility 0.4s ease;
	}

	.lightbox.active {
		opacity: 1;
		visibility: visible;
	}

	.lightbox-overlay {
		position: absolute;
		inset: 0;
		background: rgba(0, 0, 0, 0.85);
		backdrop-filter: blur(4px);
	}

	.lightbox-content {
		position: relative;
		z-index: 1;
		width: 90vw;
		max-width: 1000px;
		height: 80vh;
		display: flex;
		justify-content: center;
		align-items: center;
		transform: scale(0.9);
		opacity: 0;
		transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
	}

	.lightbox.active .lightbox-content {
		transform: scale(1);
		opacity: 1;
	}

	.lightbox-img-wrapper {
		width: 100%;
		height: 100%;
		border-radius: 12px;
		overflow: hidden;
		box-shadow: 0 10px 40px rgba(0,0,0,0.5);
	}

	.lightbox-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.lightbox-card {
		position: absolute;
		bottom: 1.5rem;
		left: 1.5rem;
		background: var(--white);
		padding: 1.5rem;
		border-radius: 12px;
		width: 100%;
		max-width: 400px;
		box-shadow: 0 10px 30px rgba(0,0,0,0.25);
		transition: transform 0.4s ease, opacity 0.4s ease;
	}

	.lightbox-card.hidden {
		opacity: 0;
		transform: translateY(20px);
		pointer-events: none;
	}

	.lightbox-toggle-card {
		position: absolute;
		bottom: 1.5rem;
		right: 1.5rem;
		background: rgba(0,0,0,0.6);
		color: white;
		border: none;
		width: 44px;
		height: 44px;
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		cursor: pointer;
		backdrop-filter: blur(4px);
		transition: background 0.3s;
		z-index: 2;
	}

	.lightbox-toggle-card:hover {
		background: rgba(0,0,0,0.8);
	}

	.lightbox-close-btn {
		position: absolute;
		top: -2.5rem;
		right: -2rem;
		background: transparent;
		border: none;
		color: white;
		font-size: 2.5rem;
		cursor: pointer;
		line-height: 1;
		transition: transform 0.3s;
	}

	.lightbox-close-btn:hover {
		transform: scale(1.15) rotate(90deg);
	}

	.lightbox-metadata {
		margin-top: 1.25rem;
		padding-top: 1rem;
		border-top: 1px solid var(--gray-200);
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
	}

	.meta-item {
		display: flex;
		align-items: flex-start;
		gap: 0.6rem;
		font-size: 0.85rem;
		color: var(--gray-700);
		line-height: 1.4;
	}

	.meta-item svg {
		color: var(--green-600);
		flex-shrink: 0;
		margin-top: 2px;
	}

	@media (max-width: 768px) {
		.lightbox-close-btn {
			top: -2.5rem;
			right: 0;
		}
		.lightbox-card {
			top: auto;
			bottom: 1.5rem;
			left: 1.5rem;
			right: 1.5rem;
			max-width: none;
		}
	}

</style>

<script>
	document.addEventListener('DOMContentLoaded', () => {
		const filterBtns = document.querySelectorAll('.filter-btn');
		const galleryItems = document.querySelectorAll('.gallery-item');

		filterBtns.forEach(btn => {
			btn.addEventListener('click', () => {
				// Remove active class from all buttons
				filterBtns.forEach(b => b.classList.remove('active'));
				// Add active class to clicked button
				btn.classList.add('active');

				const filterValue = btn.getAttribute('data-filter');

				galleryItems.forEach(item => {
					const itemCategory = item.getAttribute('data-category');
					const el = item as HTMLElement;
					
					if (filterValue === 'all' || filterValue === itemCategory) {
						el.classList.remove('hidden');
						// Small trick to trigger reflow for animation if needed
						setTimeout(() => {
							el.style.opacity = '1';
							el.style.transform = 'scale(1)';
						}, 50);
					} else {
						el.style.opacity = '0';
						el.style.transform = 'scale(0.95)';
						setTimeout(() => {
							el.classList.add('hidden');
						}, 300); // match transition time
					}
				});
			});
		});

		// Lightbox logic
		const lightbox = document.getElementById('gallery-lightbox');
		const lightboxImg = document.getElementById('lightbox-img');
		const lightboxCategory = document.getElementById('lightbox-category');
		const lightboxTitle = document.getElementById('lightbox-title');
		const lightboxDesc = document.getElementById('lightbox-desc');
		const lightboxDate = document.getElementById('lightbox-date');
		const lightboxLocation = document.getElementById('lightbox-location');
		const lightboxParties = document.getElementById('lightbox-parties');
		const lightboxCloseBtn = document.getElementById('lightbox-close-btn');
		const lightboxOverlay = document.getElementById('lightbox-close');
		const lightboxCard = document.getElementById('lightbox-card');
		const lightboxToggle = document.getElementById('lightbox-toggle-card');
		const iconHide = document.getElementById('icon-hide');
		const iconShow = document.getElementById('icon-show');
		const icons = document.querySelectorAll('.overlay-center-icon');

		icons.forEach(icon => {
			icon.addEventListener('click', (e) => {
				e.preventDefault();
				if (lightboxImg) lightboxImg.setAttribute('src', icon.getAttribute('data-img') || '');
				if (lightboxCategory) lightboxCategory.textContent = icon.getAttribute('data-category');
				if (lightboxTitle) lightboxTitle.textContent = icon.getAttribute('data-title');
				if (lightboxDesc) lightboxDesc.textContent = icon.getAttribute('data-desc');
				if (lightboxDate) lightboxDate.textContent = icon.getAttribute('data-date');
				if (lightboxLocation) lightboxLocation.textContent = icon.getAttribute('data-location');
				if (lightboxParties) lightboxParties.textContent = icon.getAttribute('data-parties');
				if (lightbox) lightbox.classList.add('active');
			});
		});

		if (lightboxToggle && lightboxCard && iconHide && iconShow) {
			lightboxToggle.addEventListener('click', (e) => {
				e.stopPropagation();
				lightboxCard.classList.toggle('hidden');
				if (lightboxCard.classList.contains('hidden')) {
					iconHide.style.display = 'none';
					iconShow.style.display = 'block';
				} else {
					iconHide.style.display = 'block';
					iconShow.style.display = 'none';
				}
			});
		}

		const closeLightbox = () => {
			if (lightbox) lightbox.classList.remove('active');
			setTimeout(() => {
				if (lightboxImg) lightboxImg.setAttribute('src', '');
				// Reset toggle state
				if (lightboxCard) lightboxCard.classList.remove('hidden');
				if (iconHide) iconHide.style.display = 'block';
				if (iconShow) iconShow.style.display = 'none';
			}, 400);
		};

		if (lightboxCloseBtn) lightboxCloseBtn.addEventListener('click', closeLightbox);
		if (lightboxOverlay) lightboxOverlay.addEventListener('click', closeLightbox);
	});
</script>
