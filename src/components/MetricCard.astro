---
export interface Props {
	variant?: 'large' | 'small';
	icon?: string;
	badge?: string;
	value: string;
	title?: string;
	description: string;
}

const { variant = 'large', icon, badge, value, title, description } = Astro.props;

// SVG Icons Mapping
const icons: Record<string, string> = {
	'solar': `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>`, // Using a generic energy/zap icon for now. Let's use zap.
	'zap': `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>`,
	'leaf-down': `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/><path d="M12 8v8"/><path d="M9 13l3 3 3-3"/></svg>`,
	'recycle': `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>`,
	'water': `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22a7 7 0 0 0 7-7c0-2-1-3.9-3-5.5s-3.5-4-4-6.5c-.5 2.5-2 4.9-4 6.5C6 11.1 5 13 5 15a7 7 0 0 0 7 7z"></path></svg>`,
	'map': `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"></polygon><line x1="8" y1="2" x2="8" y2="18"></line><line x1="16" y1="6" x2="16" y2="22"></line></svg>`,
	'wind': `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 9.5 12 12l2.5 2.5"/><path d="M9.5 9.5 12 12l-2.5 2.5"/><path d="M12 12V2"/><path d="M12 12v10"/><path d="M12 12h10"/><path d="M12 12H2"/></svg>`, // Generic fan/wind
	'tree': `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m17 14 3 3.3a1 1 0 0 1-.7 1.7H4.7a1 1 0 0 1-.7-1.7L7 14h-.3a1 1 0 0 1-.7-1.7L9 9h-.2A1 1 0 0 1 8 7.3L12 3l4 4.3a1 1 0 0 1-.8 1.7H15l3 3.3a1 1 0 0 1-.8 1.7H17z"/><path d="M12 22v-3"/></svg>`
};

const iconSvg = icon && icons[icon] ? icons[icon] : '';
---

<div class={`metric-card ${variant === 'small' ? 'card-small' : 'card-large'}`} data-animate="fade-up">
	{variant === 'large' && (
		<div class="card-header">
			<div class="card-icon-wrapper" set:html={iconSvg} />
			{badge && <span class="card-badge">{badge}</span>}
		</div>
		<div class="card-body">
			<div class="card-value">{value}</div>
			{title && <h3 class="card-title">{title}</h3>}
			<p class="card-desc">{description}</p>
		</div>
	)}

	{variant === 'small' && (
		<div class="small-card-content">
			<div class="card-icon-wrapper small-icon" set:html={iconSvg} />
			<div class="small-text-content">
				<h4 class="small-title">{value}</h4>
				<p class="small-desc">{description}</p>
			</div>
		</div>
	)}
</div>

<style>
	.metric-card {
		background: rgba(255, 255, 255, 0.05); /* Slight transparency on dark bg */
		border: 1px solid rgba(255, 255, 255, 0.1);
		border-radius: 16px;
		backdrop-filter: blur(10px);
		transition: transform var(--transition-base), background var(--transition-base), border-color var(--transition-base);
		color: var(--white);
	}

	.metric-card:hover {
		transform: translateY(-5px);
		background: rgba(255, 255, 255, 0.08);
		border-color: rgba(255, 255, 255, 0.2);
	}

	/* Large Card Styles */
	.card-large {
		padding: 1.5rem;
		display: flex;
		flex-direction: column;
		height: 100%;
	}

	.card-header {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		margin-bottom: 1.5rem;
	}

	.card-icon-wrapper {
		color: var(--green-400); /* Use lighter green for icon contrast */
		display: flex;
		align-items: center;
		justify-content: center;
	}
    
    .card-large .card-icon-wrapper :global(svg) {
        width: 28px;
        height: 28px;
    }

	.card-badge {
		background: rgba(255, 255, 255, 0.1);
		padding: 0.35rem 0.65rem;
		border-radius: 50px;
		font-size: 0.7rem;
		font-weight: 600;
		letter-spacing: 0.05em;
		color: var(--green-100);
	}

	.card-value {
		font-size: 2.25rem;
		font-weight: 700;
		font-family: var(--font-heading);
		line-height: 1;
		margin-bottom: 0.4rem;
		color: var(--white);
	}

	.card-title {
		font-size: 1rem;
		font-weight: 600;
		color: var(--green-100);
		margin-bottom: 0.75rem;
	}

	.card-desc {
		font-size: 0.85rem;
		line-height: 1.6;
		color: rgba(255, 255, 255, 0.7);
		margin: 0;
	}

	/* Small Card Styles */
	.card-small {
		padding: 1.25rem;
	}

	.small-card-content {
		display: flex;
		gap: 1rem;
		align-items: center; /* center items vertically to make it feel more cohesive */
	}

	.small-icon {
		background: rgba(255, 255, 255, 0.1);
		padding: 0.65rem;
		border-radius: 12px;
		color: var(--green-400);
	}
    
    .small-icon :global(svg) {
        width: 20px;
        height: 20px;
    }

	.small-title {
		font-size: 0.95rem;
		font-weight: 700;
		color: var(--white);
		margin: 0 0 0.25rem 0;
	}

	.small-desc {
		font-size: 0.8rem;
		line-height: 1.5;
		color: rgba(255, 255, 255, 0.7);
		margin: 0;
	}
</style>
