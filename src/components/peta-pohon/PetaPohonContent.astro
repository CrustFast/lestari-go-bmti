<section class="peta-content-section">
    <div class="container">
        <!-- Left Side: Text and Metrics -->
        <div class="content-left" data-animate="fade-up">
            <!-- Title -->
            <h2 class="main-title">
                Persebaran Ekosistem &<br />
                Ruang Terbuka Hijau (RTH)
            </h2>

            <!-- Description -->
            <p class="description">
                Jelajahi peta atau klik ikon titik pohon untuk melihat foto lapangan, nama spesies (lokal & latin), dimensi pohon, serta kelengkapan data inventarisasi.
            </p>

            <!-- Metrics / Progress Bars -->
            <div class="metrics-container">
                    <!-- Bar 1 -->
                    <div class="metric-item">
                        <div class="metric-header">
                            <span class="metric-label">Tajuk Pohon Terpetakan</span>
                            <span class="metric-value">481 Tajuk</span>
                        </div>
                        <div class="progress-bar-bg">
                            <div class="progress-bar-fill" style="width: 100%;"></div>
                        </div>
                        <div class="metric-footer">
                            <span>Berdasarkan hasil pemetaan kawasan kampus</span>
                        </div>
                    </div>

                    <!-- Bar 2 -->
                    <div class="metric-item">
                        <div class="metric-header">
                            <span class="metric-label">Pohon Tersurvei Lapangan</span>
                            <span class="metric-value">262 Pohon</span>
                        </div>
                        <div class="progress-bar-bg">
                            <div class="progress-bar-fill" style="width: 54%;"></div>
                        </div>
                        <div class="metric-footer">
                            <span>Terdiri dari 87 jenis (spesies) berbeda</span>
                        </div>
                    </div>

                    <!-- Bar 3 -->
                    <div class="metric-item">
                        <div class="metric-header">
                            <span class="metric-label">Luas Area Pemetaan</span>
                            <span class="metric-value">13.0 Hektar</span>
                        </div>
                        <div class="progress-bar-bg">
                            <div class="progress-bar-fill fill-blue" style="width: 100%;"></div>
                        </div>
                        <div class="metric-footer">
                            <span>Terbagi ke dalam 8 blok kawasan kampus</span>
                        </div>
                    </div>
            </div>
            
            <!-- CTA Button -->
            <div class="cta-container">
                <a href="/peta-gis.html" target="_blank" class="btn btn-primary btn-animated">
                    <svg class="btn-icon-custom" width="28" height="28" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <circle class="icon-bg" cx="12" cy="12" r="12" fill="white"/>
                        <path class="icon-arrow" d="M9.5 14.5L14.5 9.5M14.5 9.5H10.5M14.5 9.5V13.5" stroke="var(--btn-primary-bg)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    <span class="btn-text">Buka Peta GIS Inventarisasi Lengkap</span>
                </a>
            </div>
        </div>

        <!-- Right Side: Map -->
        <div class="content-right" data-animate="fade-up" style="animation-delay: 0.2s;">
            <div class="map-container">
                <iframe 
                    id="gis-iframe"
                    src="/peta-gis.html" 
                    title="Peta Pohon GIS Interaktif" 
                    class="gis-iframe"
                    loading="lazy">
                </iframe>
            </div>
        </div>
    </div>
</section>

<style>
    .peta-content-section {
        min-height: 100vh;
        background-color: #051A0F; /* Deep dark green */
        display: flex;
        align-items: center;
        padding: 6rem 0;
        color: var(--white, #ffffff);
    }
    
    .container {
        width: 100%;
        max-width: var(--container-max);
        margin: 0 auto;
        padding: 0 var(--container-padding);
        display: grid;
        grid-template-columns: 3.5fr 6.5fr;
        gap: 3rem;
        align-items: center;
    }

    /* --- Left Side --- */
    .content-left {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .main-title {
        font-size: clamp(1.5rem, 2.5vw, 1.75rem);
        font-weight: 700;
        line-height: 1.2;
        letter-spacing: -0.02em;
        margin-bottom: 0.5rem;
    }

    .description {
        font-size: 0.9rem;
        line-height: 1.6;
        color: rgba(255, 255, 255, 0.7);
        margin-bottom: 0.5rem;
    }

    /* Metrics */
    .metrics-container {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
        margin-top: 0.5rem;
    }

    .metric-item {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .metric-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        font-size: 0.85rem;
        font-weight: 600;
        gap: 0.5rem;
    }

    .metric-value {
        color: rgba(255, 255, 255, 0.9);
        font-size: 0.85rem;
        white-space: nowrap;
    }

    .progress-bar-bg {
        width: 100%;
        height: 8px;
        background: rgba(255, 255, 255, 0.1);
        border-radius: 4px;
        overflow: hidden;
    }

    .progress-bar-fill {
        height: 100%;
        background: #22c55e; /* Bright green */
        border-radius: 4px;
        transition: width 1s ease-out;
    }

    .metric-footer {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        font-size: 0.7rem;
        color: rgba(255, 255, 255, 0.5);
    }

    /* CTA Button */
    .cta-container {
        margin-top: 1rem;
    }
    
    .cta-container .btn {
        width: 100%;
        border-radius: 10px;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 1rem 1.5rem;
        position: relative;
    }

    .cta-container .btn-text {
        transition: opacity 0.4s cubic-bezier(0.4, 0, 0.2, 1), transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        transform: translateX(-12px); /* Shift text slightly to the left initially */
    }

    .cta-container .btn:hover .btn-text {
        opacity: 0;
        transform: translateX(15px); /* Slide text out to the right (or opposite of left) */
    }

    .cta-container .btn svg {
        position: absolute;
        left: 1.5rem;
        transition: left 0.4s cubic-bezier(0.4, 0, 0.2, 1), transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    }
    
    .cta-container .btn:hover svg {
        left: 50%;
        transform: translateX(-50%);
    }

    .cta-container .btn .icon-arrow {
        transition: transform 0.3s ease;
        transform-origin: center;
    }

    .cta-container .btn:hover .icon-arrow {
        transform: translate(2px, -2px);
    }

    .fill-blue {
        background: #38bdf8 !important;
    }

    /* --- Right Side (Map) --- */
    .content-right {
        width: 100%;
        height: 100%;
        min-height: 550px;
    }

    .map-container {
        width: 100%;
        height: 100%;
        min-height: 550px;
        background: #ffffff;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
        display: flex;
    }

    .gis-iframe {
        width: 100%;
        height: 100%;
        min-height: 550px;
        border: none;
    }

    /* Responsive */
    @media (max-width: 992px) {
        .container {
            grid-template-columns: 1fr;
            padding-top: 4rem;
        }
        
        .content-right, .map-container, .gis-iframe {
            min-height: 450px;
        }
    }
</style>

<script>
    // Inject CSS to hide the sidebar when the map is embedded in the iframe
    document.addEventListener("DOMContentLoaded", () => {
        const iframe = document.getElementById('gis-iframe') as HTMLIFrameElement;
        if (iframe) {
            iframe.addEventListener('load', () => {
                try {
                    const style = document.createElement('style');
                    style.textContent = `
                        #side { display: none !important; } 
                        #drawer-btn { display: none !important; }
                        #mapwrap { flex: 1 !important; width: 100% !important; }
                    `;
                    iframe.contentWindow?.document.head.appendChild(style);
                    
                    // Trigger map resize if Leaflet is accessible
                    setTimeout(() => {
                        if (iframe.contentWindow && (iframe.contentWindow as any).map) {
                            (iframe.contentWindow as any).map.invalidateSize();
                        }
                    }, 300);
                } catch (e) {
                    console.error('Failed to inject iframe styles:', e);
                }
            });
        }
    });
</script>
